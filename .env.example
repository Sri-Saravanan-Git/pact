# PayPal SANDBOX app (developer.paypal.com > Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox accounts (Testing Tools > Sandbox Accounts). Freelancer = payee on every order.
PAYPAL_MERCHANT_EMAIL=
PAYPAL_FREELANCER_EMAIL=
PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_PASSWORD=
# Optional: set after deploying (node --env-file=.env.local scripts/webhook.mjs https://your-app)
PAYPAL_WEBHOOK_ID=

# Google AI Studio key (free tier works)
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash

# Neon Postgres (pooled URL recommended on Vercel)
DATABASE_URL=
DATABASE_URL_POOLED=
